# Dockerfile.demo — self-contained, portable CICIoT2023 IDS demo & SOC dashboard
# Works out-of-the-box on Windows, Linux, and macOS without requiring volume mounts.

FROM python:3.11-slim

# System deps:
# - libpcap0.8: raw packet sniffing & crafting with scapy
# - iproute2, net-tools: network inspection utilities
# - libgomp1: OpenMP runtime required by LightGBM
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpcap0.8 \
        iproute2 \
        net-tools \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir \
        scapy>=2.5.0 \
        scikit-learn \
        xgboost \
        lightgbm \
        joblib \
        pyyaml \
        pandas \
        numpy \
        matplotlib \
        seaborn \
        streamlit \
        plotly \
        pyarrow \
    && pip install --no-cache-dir imbalanced-learn

# Copy application code, models, and curated demo dataset
COPY . .

# Set environment
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8501

# Default command: launch the visual SOC Streamlit dashboard
CMD ["streamlit", "run", "demo_dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
